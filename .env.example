# ==========================================
# Notification Provider Configuration
# ==========================================
# Options: 'telegram' (100% free, instant, recommended), 'callmebot', or 'twilio'
NOTIFICATION_PROVIDER=telegram

# --- Telegram Configuration (Recommended: Free forever, no timeouts) ---
# Create a bot via @BotFather on Telegram to get your bot token
TELEGRAM_BOT_TOKEN=
# Get your numeric chat ID by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=

# --- CallMeBot Configuration (WhatsApp) ---
# Your international phone number with country code without + or spaces (e.g., 2348012345678)
CALLMEBOT_PHONE=
# The API key you receive after messaging CallMeBot on WhatsApp
CALLMEBOT_API_KEY=

# --- Twilio Configuration (WhatsApp Sandbox) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+2348012345678

# ==========================================
# AI Enrichment (Optional)
# ==========================================
# Free Google AI Studio API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Optional timezone label for message header
TIMEZONE=UTC

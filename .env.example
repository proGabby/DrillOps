# ==========================================
# WhatsApp Provider Configuration
# ==========================================
# Options: 'callmebot' (recommended, no 72h timeout) or 'twilio'
WHATSAPP_PROVIDER=callmebot

# --- CallMeBot Configuration (Recommended) ---
# Your international phone number with country code without + or spaces (e.g., 2348012345678)
CALLMEBOT_PHONE=
# The API key you receive after messaging CallMeBot on WhatsApp
CALLMEBOT_API_KEY=

# --- Twilio Configuration (Alternative) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+2348012345678

# ==========================================
# AI Enrichment (Optional but Recommended)
# ==========================================
# Free Google AI Studio API key (https://aistudio.google.com/app/apikey)
# If left empty, the pipeline will deliver high-quality curated questions without AI variations.
GEMINI_API_KEY=

# Optional timezone label for message header
TIMEZONE=UTC
